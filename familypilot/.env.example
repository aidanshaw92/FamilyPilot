# FamilyPilot — environment variables
#
# Copy this file to `.env` for local development, or set these as Project
# Environment Variables in the Vercel dashboard for the deployed app.
# Nothing here is required to run the app — every provider has an honest,
# clearly-labelled fallback (mock data, estimated distances/weather, or a
# 503 "not configured" response) when its key is missing. Add keys
# incrementally to unlock more real functionality.

# ---------------------------------------------------------------------------
# Places (Google Places API — venue search, detail, photos)
# ---------------------------------------------------------------------------
# Selects the provider chain used by api/places/*. One of: google | osm | mock
# Without a key, `google` silently degrades to osm -> mock.
PLACES_PROVIDER=google

# Get from: https://console.cloud.google.com/apis/credentials
# Enable: "Places API (New)" and "Geocoding API" on the same GCP project.
# Used by: api/places/search.js, api/places/detail.js, api/places/photo.js,
# api/planning/location.js (geocoding), api/context/journey.js (drive times).
GOOGLE_PLACES_API_KEY=
# Alternative/fallback name accepted by the same code paths.
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Weather (OpenWeather — used to bias indoor/outdoor recommendations)
# ---------------------------------------------------------------------------
# Get from: https://openweathermap.org/api
# Without this, api/context/weather.js returns a deterministic seasonal/
# time-of-day estimate, labelled `source: "estimated"` (never fake-live).
OPENWEATHER_API_KEY=

# ---------------------------------------------------------------------------
# AI (OpenAI — natural-language day-request parsing + venue enrichment drafts)
# ---------------------------------------------------------------------------
# Get from: https://platform.openai.com/api-keys
# Without this: free-text "Plan a day" requests fall back to a deterministic
# mock parser, and the enrichment console cannot generate AI drafts (source-
# backed evidence extraction still works without it).
OPENAI_API_KEY=
AI_PARSE_MODEL=gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
AI_ENRICHMENT_ALLOW_MOCK=false
AI_ENRICHMENT_MAX_TOKENS=
AI_ENRICHMENT_RETRY_LIMIT=
AI_ENRICHMENT_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# Supabase — server side (service role; NEVER expose in client bundle)
# ---------------------------------------------------------------------------
# Get from: Supabase project settings -> API. Must be the `service_role`
# secret key, not the anon/publishable key — the code validates this.
# Powers: family connection codes (api/planning/connections.js), post-visit
# feedback (api/planning/feedback.js), and the venue enrichment/evidence/
# trust pipeline (api/enrichment/index.js, server/enrichment/_lib/*).
# Without these, those routes return 503 "not configured yet".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Some code paths also accept this name for the same secret.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Supabase — client side (safe to expose; anon/publishable key only)
# ---------------------------------------------------------------------------
# Same project as above. Powers client-side auth for "Plans" -> connecting
# families and cloud-backing planning workspaces. Without these, the client
# Supabase instance is null and the UI shows "Account connections need to be
# enabled by the app owner" rather than failing silently.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Client API base URLs (optional — default to same-origin `/api/...`)
# ---------------------------------------------------------------------------
# Only needed if the API is served from a different origin than the app
# (e.g. local Expo dev client pointed at a deployed Vercel API).
EXPO_PUBLIC_PLACES_API_URL=
EXPO_PUBLIC_CONTEXT_API_URL=
EXPO_PUBLIC_PLANNING_API_URL=
EXPO_PUBLIC_RECOMMENDATIONS_API_URL=

# ---------------------------------------------------------------------------
# Feature visibility
# ---------------------------------------------------------------------------
# Set to "true" to reveal features deferred for the parent-testing pilot
# (Plans/Trips tab, restaurants, holiday, packing, car fit, concierge).
# See src/config/pilot-features.ts. Leave unset/false for the public pilot build.
EXPO_PUBLIC_SHOW_DEFERRED_FEATURES=false

# ---------------------------------------------------------------------------
# Internal venue enrichment console (not consumer-facing)
# ---------------------------------------------------------------------------
# Bearer token required to call api/enrichment/index.js admin routes.
ENRICHMENT_ADMIN_TOKEN=
# "true" to auto-approve high-confidence, source-backed enrichment drafts
# without manual review. Leave unset/false to require human review.
ENRICHMENT_AUTO_APPROVE=false
# Restricts automatic venue discovery/enrichment to a radius around one
# point (used during the north-west London pilot). Leave unset to disable
# the geographic restriction.
ENRICHMENT_BETA_LAT=
ENRICHMENT_BETA_LNG=
ENRICHMENT_BETA_RADIUS_KM=
ENRICHMENT_BETA_LABEL=

# Evidence-fetch tuning (sensible defaults in code; override only if needed)
SOURCE_FETCH_TIMEOUT_MS=
SOURCE_FETCH_MAX_BYTES=
SOURCE_MAX_PAGES=
SOURCE_EVIDENCE_CACHE_DAYS=
