{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "framework": null,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/venue/:id",
      "destination": "/venue/[id].html"
    }
  ]
}
